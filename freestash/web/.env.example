# "none" = local single-user mode (matches FREESTASH_AUTH_MODE=none on the API)
# "supabase" = team mode; sign in with Supabase Auth, token is sent to the API
VITE_AUTH_MODE=none
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Leave empty when the API serves the UI (same origin). Set for a separately hosted API.
VITE_API_BASE=
