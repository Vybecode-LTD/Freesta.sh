# ---- identity (required: several APIs throttle anonymous clients) ----
FREESTASH_CONTACT_EMAIL=you@yourstudio.com
FREESTASH_USER_AGENT=Freestash/0.1 (internal asset finder)

# ---- storage (defaults: ~/.freestash/freestash.db and ~/.freestash/downloads) ----
# FREESTASH_DATA_DIR=
# FREESTASH_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# FREESTASH_DOWNLOAD_DIR=

# ---- behaviour ----
FREESTASH_PROVIDER_TIMEOUT=30
FREESTASH_MAX_DOWNLOAD_MB=250
# FREESTASH_DISABLED_PROVIDERS=["vam"]

# ---- provider keys (all optional; keyed providers stay off without them) ----
SMITHSONIAN_API_KEY=          # https://api.data.gov/signup/
EUROPEANA_API_KEY=            # https://pro.europeana.eu/pages/get-api  (falls back to shared demo key)
FREESOUND_API_KEY=            # https://freesound.org/apiv2/apply/
UNSPLASH_ACCESS_KEY=          # https://unsplash.com/developers
PEXELS_API_KEY=               # https://www.pexels.com/api/
PIXABAY_API_KEY=              # https://pixabay.com/api/docs/
WIKIMEDIA_ACCESS_TOKEN=       # OAuth 2.0 owner-only token: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
OPENVERSE_CLIENT_ID=          # https://api.openverse.org/v1/#tag/auth/operation/register
OPENVERSE_CLIENT_SECRET=

# ---- web API / team mode ----
FREESTASH_AUTH_MODE=none         # none | supabase
SUPABASE_URL=
SUPABASE_JWT_SECRET=          # only for legacy HS256 projects; new projects verify via JWKS
FREESTASH_CORS_ORIGINS=["http://localhost:5173"]
