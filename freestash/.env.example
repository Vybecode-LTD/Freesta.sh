# ---- identity (required: several APIs throttle anonymous clients) ----
FREESTASH_CONTACT_EMAIL=you@yourstudio.com
FREESTASH_USER_AGENT=Freestash/0.1 (+https://freesta.sh; asset finder)

# ---- storage (defaults: ~/.freestash/freestash.db and ~/.freestash/downloads) ----
# FREESTASH_DATA_DIR=
# On Railway, reference the Postgres service instead: DATABASE_URL=${{Postgres.DATABASE_URL}}
# (postgres:// and postgresql:// are rewritten to the psycopg 3 driver automatically)
# FREESTASH_DATABASE_URL=
# FREESTASH_DOWNLOAD_DIR=

# ---- behaviour ----
FREESTASH_PROVIDER_TIMEOUT=30
FREESTASH_MAX_DOWNLOAD_MB=250
# FREESTASH_DISABLED_PROVIDERS=["vam"]

# ---- accounts (the hosted app; leave AUTH_MODE=none to run on your own machine) ----
FREESTASH_AUTH_MODE=none                 # none | accounts
# FREESTASH_SECRET_KEY=                  # 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
# FREESTASH_SECRETS_KEY=                 # encrypts users' API keys: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# FREESTASH_SIGNUP_OPEN=true
# FREESTASH_SHARE_SERVER_KEYS=false      # true = users without their own key use the keys below
# FREESTASH_PUBLIC_URL=https://freesta.sh
# FREESTASH_TRUST_CF_CONNECTING_IP=false   # true only if Cloudflare proxies the domain (else clients can forge it)
# RESEND_API_KEY=                        # password-reset email; without it no reset email is sent (links are never logged)
# FREESTASH_LOG_EMAILS=false             # dev only: print unsent emails, reset links included (dev_accounts.py sets it)
# FREESTASH_EMAIL_FROM=Freesta.sh <hello@freesta.sh>
FREESTASH_CORS_ORIGINS=["http://localhost:5173"]

# ---- provider keys (all optional; keyed providers stay off without them) ----
# In accounts mode each user saves their own in Settings. Where to get each one: GET /api/keys/catalog
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
FREESOUND_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
WIKIMEDIA_ACCESS_TOKEN=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
