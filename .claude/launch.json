{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "freestash-accounts",
      "runtimeExecutable": "freestash/.venv/Scripts/python.exe",
      "runtimeArgs": ["freestash/scripts/dev_accounts.py", "--port", "8790"],
      "port": 8790
    },
    {
      "name": "freestash-local",
      "cwd": "freestash",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "freestash", "serve", "--port", "8791"],
      "port": 8791
    }
  ]
}
