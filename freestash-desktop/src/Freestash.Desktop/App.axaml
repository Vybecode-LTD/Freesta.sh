<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Freestash.Desktop.App"
             RequestedThemeVariant="Dark"
             Name="Freestash">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Freestash/Styles/Icons.axaml" />
    <StyleInclude Source="avares://Freestash/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
