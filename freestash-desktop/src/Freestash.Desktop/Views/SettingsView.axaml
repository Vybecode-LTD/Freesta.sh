<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:c="using:Freestash.Desktop.Controls"
             x:Class="Freestash.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- Same sections and order as the web's pages/SettingsPage.tsx (Account, API keys, Search defaults, Appearance),
       plus what only a desktop has: Connection and Downloads. -->
  <UserControl.Resources>
    <ControlTheme x:Key="ThemeCardTheme" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Card" Padding="10" CornerRadius="13" BorderThickness="1"
                  Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Card"><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Style>
      <Style Selector="^:checked /template/ Border#PART_Card">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource AccentRingShadow}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SwatchTheme" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Swatch" Padding="9,7,13,7" CornerRadius="999" BorderThickness="1"
                  Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#PART_Swatch">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource AccentRingShadow}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <DockPanel>
    <!-- save bar -->
    <Border DockPanel.Dock="Bottom" Padding="30,14" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <c:Icon Data="{StaticResource IconShield}" Size="15" Classes="muted" />
          <TextBlock Text="{Binding SaveNote}" Classes="muted small" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="Revert" Command="{Binding RevertCommand}" />
          <Button Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" Padding="18,8">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{StaticResource IconSave}" Size="15" /><TextBlock Text="Save changes" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="30,24,30,30">
      <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">
        <StackPanel Spacing="6" Margin="0,0,0,6">
          <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" LetterSpacing="-1.1" />
          <TextBlock Text="Your account, provider keys, search defaults and look. Everything synced follows you to freesta.sh." Classes="muted" />
        </StackPanel>

        <!-- ===================================================== account -->
        <Border Classes="card" Padding="24" IsVisible="{Binding KeysInAccount}">
          <Grid ColumnDefinitions="260,*">
            <StackPanel Spacing="8" Margin="0,0,32,0">
              <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Data="{StaticResource IconUser}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Account" Classes="h3" FontSize="16" /></StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" LineHeight="19" Text="The same account as the website. Collections, ledger, keys and preferences sync between them." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding AccountEmail}" Classes="mono" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding SignOutCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{StaticResource IconSignOut}" Size="15" /><TextBlock Text="Sign out" /></StackPanel>
                </Button>
                <Button Classes="ghost" Content="Sign out everywhere" Command="{Binding SignOutEverywhereCommand}" />
                <Button Classes="link small" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding OpenUrlCommand}" CommandParameter="https://freesta.sh/#/settings"
                        Content="Change name or password on freesta.sh ↗" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===================================================== keys -->
        <Border Classes="card" Padding="24">
          <Grid ColumnDefinitions="260,*">
            <StackPanel Spacing="8" Margin="0,0,32,0">
              <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Data="{StaticResource IconKey}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="API keys" Classes="h3" FontSize="16" /></StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" LineHeight="19" Text="{Binding KeysIntro}" />
              <TextBlock Text="{Binding KeysSummary}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:KeyRowViewModel">
                  <Border Classes="raised" Padding="16" CornerRadius="13">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Panel Grid.Column="2">
                          <TextBlock Classes="verdict" Text="{Binding StatusText}" Foreground="{DynamicResource GreenBrush}" IsVisible="{Binding IsSet}" />
                          <TextBlock Classes="verdict" Text="{Binding StatusText}" Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsSite}" />
                          <TextBlock Classes="verdict" Text="{Binding StatusText}" Foreground="{DynamicResource YellowBrush}" IsVisible="{Binding IsMissing}" />
                          <TextBlock Classes="verdict" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding ShowsOptional}" />
                        </Panel>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Text="{Binding Value}" Classes="mono" PasswordChar="{Binding Mask}" PlaceholderText="{Binding Placeholder}" />
                        <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Command="{Binding ToggleRevealCommand}" ToolTip.Tip="Show or hide the key" IsVisible="{Binding HasSaved}">
                          <Panel>
                            <c:Icon Data="{StaticResource IconEye}" Size="15" IsVisible="{Binding !IsRevealed}" />
                            <c:Icon Data="{StaticResource IconEyeOff}" Size="15" IsVisible="{Binding IsRevealed}" />
                          </Panel>
                        </Button>
                        <Button Grid.Column="2" Classes="icon" Margin="6,0,0,0" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this key" IsVisible="{Binding HasSaved}">
                          <c:Icon Data="{StaticResource IconTrash}" Size="15" />
                        </Button>
                      </Grid>

                      <!-- where to get it: right under the input, the same text as the website -->
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="11" Padding="14,12">
                        <StackPanel Spacing="8">
                          <Border IsVisible="{Binding HasNotice}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource YellowBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <c:Icon Data="{StaticResource IconWarning}" Size="15" Foreground="{DynamicResource YellowBrush}" VerticalAlignment="Top" />
                              <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="13" />
                            </StackPanel>
                          </Border>
                          <Button Classes="link" HorizontalAlignment="Left" IsVisible="{Binding ShowLink}"
                                  Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <c:Icon Data="{StaticResource IconExternal}" Size="15" />
                              <TextBlock Text="Get this key at" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding UrlLabel}" Classes="mono" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsRegister}">
                            <Button Classes="small" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RegisterOpenverseCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{StaticResource IconSparkle}" Size="14" /><TextBlock Text="Register with Openverse" /></StackPanel>
                            </Button>
                            <Button Classes="link small" VerticalAlignment="Center" Content="About Openverse credentials ↗"
                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}" />
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:KeyStep">
                                <Grid ColumnDefinitions="22,*">
                                  <TextBlock Text="{Binding Number, StringFormat='{}{0}.'}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding Foot}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- ===================================================== search defaults -->
        <Border Classes="card" Padding="24">
          <Grid ColumnDefinitions="260,*">
            <StackPanel Spacing="8" Margin="0,0,32,0">
              <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Data="{StaticResource IconSearch}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Search defaults" Classes="h3" FontSize="16" /></StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" LineHeight="19" Text="What a new search starts with, here and on the website." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14">
              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Spacing="8" Margin="0,0,12,0">
                  <TextBlock Text="USE" Classes="caption" />
                  <ComboBox ItemsSource="{Binding UseCases}" SelectedItem="{Binding DefaultUseCase}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" Margin="0,0,12,0">
                  <TextBlock Text="SHOW UP TO" Classes="caption" />
                  <ComboBox ItemsSource="{Binding TierChoices}" SelectedItem="{Binding DefaultMaxTier}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="RESULTS PER SOURCE" Classes="caption" />
                  <NumericUpDown Value="{Binding ResultsPerSource}" Minimum="1" Maximum="50" FormatString="0" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="8">
                <TextBlock Text="MEDIA" Classes="caption" />
                <ItemsControl ItemsSource="{Binding Media}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:MediaOption"><ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===================================================== appearance -->
        <Border Classes="card" Padding="24">
          <Grid ColumnDefinitions="260,*">
            <StackPanel Spacing="8" Margin="0,0,32,0">
              <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Data="{StaticResource IconSun}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Appearance" Classes="h3" FontSize="16" /></StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" LineHeight="19" Text="Previews instantly. Saved to your account." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="16">
              <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ThemeOption">
                    <RadioButton GroupName="theme" IsChecked="{Binding IsSelected}" Theme="{StaticResource ThemeCardTheme}">
                      <StackPanel Spacing="10" Width="250">
                        <Border Height="92" CornerRadius="10" Background="{Binding Canvas}" ClipToBounds="True">
                          <Grid ColumnDefinitions="54,*" Margin="10">
                            <StackPanel Spacing="5">
                              <Border Height="7" CornerRadius="3" Background="{Binding Surface}" />
                              <Border Height="7" CornerRadius="3" Background="{Binding Surface}" Opacity="0.7" />
                              <Border Height="7" CornerRadius="3" Background="{Binding Surface}" Opacity="0.7" />
                            </StackPanel>
                            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="7" Background="{Binding Surface}">
                              <StackPanel Margin="9" Spacing="6">
                                <Border Height="6" Width="70" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Text}" Opacity="0.85" />
                                <Border Height="5" Width="110" HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Text}" Opacity="0.35" />
                                <Border Height="14" Width="52" HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,6,0,0" />
                              </StackPanel>
                            </Border>
                          </Grid>
                        </Border>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Description}" Classes="muted small" TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="8">
                <TextBlock Text="ACCENT" Classes="caption" />
                <ItemsControl ItemsSource="{Binding Accents}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:AccentOption">
                      <RadioButton GroupName="accent" IsChecked="{Binding IsSelected}" Theme="{StaticResource SwatchTheme}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse Width="16" Height="16" Fill="{Binding Hex}" />
                          <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===================================================== connection (desktop only) -->
        <Border Classes="card" Padding="24">
          <Grid ColumnDefinitions="260,*">
            <StackPanel Spacing="8" Margin="0,0,32,0">
              <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Data="{StaticResource IconBolt}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Connection" Classes="h3" FontSize="16" /></StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" LineHeight="19"
                         Text="Your freesta.sh account runs searches on the hosted engine, the same one the website uses. A local engine runs the Python engine on this computer, with no account." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <RadioButton Theme="{StaticResource PillRadioTheme}" GroupName="mode" IsChecked="{Binding IsRemote}" Content="Freesta.sh account" />
                <RadioButton Theme="{StaticResource PillRadioTheme}" GroupName="mode" IsChecked="{Binding IsLocal}" Content="Local engine (advanced)" />
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding IsRemote}">
                <TextBlock Text="SERVER" Classes="caption" />
                <TextBox Text="{Binding RemoteUrl}" Classes="mono" PlaceholderText="https://freesta.sh" />
              </StackPanel>

              <Grid ColumnDefinitions="*,140" IsVisible="{Binding IsLocal}">
                <StackPanel Spacing="8">
                  <TextBlock Text="PYTHON COMMAND" Classes="caption" />
                  <TextBox Text="{Binding PythonCommand}" Classes="mono" PlaceholderText="python" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                  <TextBlock Text="PORT" Classes="caption" />
                  <NumericUpDown Value="{Binding LocalPort}" Minimum="1024" Maximum="65535" FormatString="0" ShowButtonSpinner="False" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLocal}">
                <ToggleSwitch IsChecked="{Binding AutoStartEngine}" />
                <TextBlock Text="Start the engine automatically (runs python -m freestash serve)" Classes="muted small" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding IsLocal}">
                <TextBlock Text="CONTACT EMAIL" Classes="caption" />
                <TextBox Text="{Binding ContactEmail}" PlaceholderText="you@studio.com · sent in the User-Agent; Wikimedia and others throttle anonymous clients" />
              </StackPanel>

              <Border Classes="inset" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{Binding EngineStatus}" Classes="mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1" Classes="small" Margin="8,0,0,0" Content="Test" Command="{Binding TestConnectionCommand}" />
                  <Button Grid.Column="2" Classes="small" Margin="6,0,0,0" Command="{Binding RestartEngineCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{StaticResource IconRetry}" Size="13" /><TextBlock Text="Reconnect" /></StackPanel>
                  </Button>
                </Grid>
              </Border>
              <StackPanel Spacing="8" IsVisible="{Binding IsLocal}">
                <ToggleButton x:Name="LogToggle" Classes="ghost-toggle" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <c:Icon Data="{StaticResource IconChevronDown}" Size="14" />
                    <TextBlock Text="Engine log" FontSize="12.5" />
                  </StackPanel>
                </ToggleButton>
                <Border Classes="inset" Padding="12" MaxHeight="220" IsVisible="{Binding #LogToggle.IsChecked}">
                  <ScrollViewer>
                    <SelectableTextBlock Text="{Binding EngineLog}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===================================================== downloads (desktop only) -->
        <Border Classes="card" Padding="24">
          <Grid ColumnDefinitions="260,*">
            <StackPanel Spacing="8" Margin="0,0,32,0">
              <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Data="{StaticResource IconDownload}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Downloads" Classes="h3" FontSize="16" /></StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" LineHeight="19" Text="Where files go on this computer and what travels with them." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14">
              <StackPanel Spacing="8">
                <TextBlock Text="DEFAULT FOLDER" Classes="caption" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding DownloadDirectory}" Classes="mono" />
                  <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" Command="{Binding BrowseDownloadsCommand}"><c:Icon Data="{StaticResource IconFolder}" Size="15" /></Button>
                </Grid>
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                  <ToggleSwitch IsChecked="{Binding OrganizeByProject}" /><TextBlock Text="Sub-folder per project" Classes="small" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                  <ToggleSwitch IsChecked="{Binding WriteSidecars}" /><TextBlock Text="Write .license.json sidecars" Classes="small" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch IsChecked="{Binding RecordInLedger}" /><TextBlock Text="Record in the license ledger" Classes="small" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch IsChecked="{Binding WatchClipboard}" /><TextBlock Text="Watch clipboard for links" Classes="small" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="8">
                <TextBlock Text="PARALLEL DOWNLOADS" Classes="caption" />
                <NumericUpDown Value="{Binding MaxConcurrent}" Minimum="1" Maximum="8" FormatString="0" Width="140" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Button Classes="link small" HorizontalAlignment="Left" Command="{Binding OpenConfigFolderCommand}">
          <TextBlock Text="{Binding ConfigPath, StringFormat='Settings file: {0}'}" FontSize="12" Classes="mono" />
        </Button>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
