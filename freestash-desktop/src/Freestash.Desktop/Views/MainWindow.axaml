<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Freestash.Desktop.ViewModels"
        xmlns:v="using:Freestash.Desktop.Views"
        xmlns:c="using:Freestash.Desktop.Controls"
        xmlns:conv="using:Freestash.Desktop.Converters"
        x:Class="Freestash.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Freesta.sh"
        Icon="avares://Freestash/Assets/freestash.ico"
        Width="1440" Height="920" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:SearchViewModel"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="vm:CollectionsViewModel"><v:CollectionsView /></DataTemplate>
    <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
    <DataTemplate DataType="vm:LedgerViewModel"><v:LedgerView /></DataTemplate>
    <DataTemplate DataType="vm:LicenseCheckViewModel"><v:LicenseCheckView /></DataTemplate>
    <DataTemplate DataType="vm:SourcesViewModel"><v:SourcesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <!-- Same shell as the web's App.tsx: rail with LIBRARY / TOOLS, account card at the foot, page on the canvas. -->
  <Grid RowDefinitions="46,*" ColumnDefinitions="236,*">

    <!-- ===================================================== rail -->
    <Border Grid.RowSpan="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" />
    <Border WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent">
      <StackPanel x:Name="Wordmark" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="freesta" FontSize="21" FontWeight="Bold" LetterSpacing="-0.9" />
        <TextBlock Text=".sh" FontSize="21" FontWeight="Bold" LetterSpacing="-0.9" Foreground="{DynamicResource AccentTextBrush}" />
      </StackPanel>
    </Border>

    <DockPanel Grid.Row="1" Margin="14,4,14,16" LastChildFill="False">
      <!-- account card -->
      <Button DockPanel.Dock="Bottom" Command="{Binding GoSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Padding="14,12" CornerRadius="13" Background="{DynamicResource SurfaceBrush}" ToolTip.Tip="Account and settings">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding AccountName}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Effect="drop-shadow(0 0 6 #904BE08A)" />
            <TextBlock Text="{Binding AccountSub}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
      </Button>

      <StackPanel DockPanel.Dock="Top" Spacing="2">
        <ItemsControl ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Section}" Classes="caption" Margin="10,16,0,8" IsVisible="{Binding HasSection}" />
                <RadioButton Theme="{StaticResource NavTheme}" IsChecked="{Binding IsSelected}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Data="{Binding Icon, Converter={x:Static conv:IconKeyConverter.Instance}}" Size="17" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" IsVisible="{Binding HasBadge}" Background="{DynamicResource AccentBrush}" CornerRadius="999"
                            MinWidth="20" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </RadioButton>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <RadioButton Theme="{StaticResource NavTheme}" IsChecked="{Binding SettingsItem.IsSelected}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <c:Icon Data="{StaticResource IconSliders}" Size="17" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </DockPanel>

    <!-- ===================================================== title bar over the page (draggable) -->
    <Border Grid.Column="1" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent">
      <Grid x:Name="TitleBarGrid" ColumnDefinitions="*,Auto,Auto" Margin="30,0,150,0">
        <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Center" Command="{Binding GoSettingsCommand}" ToolTip.Tip="Connection · click for Settings">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Panel Width="7" Height="7" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource GreenBrush}" IsVisible="{Binding EngineOnline}" />
              <Ellipse Fill="{DynamicResource YellowBrush}" IsVisible="{Binding EngineStarting}" />
              <Ellipse Fill="{DynamicResource RedBrush}" IsVisible="{Binding EngineOffline}" />
            </Panel>
            <TextBlock Text="{Binding EngineText}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="ghost small" Margin="6,0,0,0" VerticalAlignment="Center" Command="{Binding GoSearchCommand}" ToolTip.Tip="Focus search">
          <Border Classes="pill" Padding="7,1"><TextBlock Text="CTRL K" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
        </Button>
      </Grid>
    </Border>

    <!-- ===================================================== page -->
    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- ===================================================== sign-in (hosted mode, no session) -->
    <v:SignInView Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding SignIn}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NeedsSignIn}" />

    <!-- ===================================================== toast -->
    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="{Binding Toasts.IsVisible}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="236,0,0,30"
            Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="13" Padding="18,11" BoxShadow="{DynamicResource PopShadow}" IsHitTestVisible="False" MaxWidth="560">
      <TextBlock Text="{Binding Toasts.Message}" FontSize="13" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
