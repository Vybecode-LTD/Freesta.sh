<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Freestash.Desktop.ViewModels"
        xmlns:v="using:Freestash.Desktop.Views"
        xmlns:c="using:Freestash.Desktop.Controls"
        xmlns:conv="using:Freestash.Desktop.Converters"
        x:Class="Freestash.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Freestash"
        Icon="avares://Freestash/Assets/freestash.ico"
        Width="1440" Height="920" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:SearchViewModel"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="vm:CollectionsViewModel"><v:CollectionsView /></DataTemplate>
    <DataTemplate DataType="vm:DownloadsViewModel"><v:DownloadsView /></DataTemplate>
    <DataTemplate DataType="vm:LedgerViewModel"><v:LedgerView /></DataTemplate>
    <DataTemplate DataType="vm:LicenseCheckViewModel"><v:LicenseCheckView /></DataTemplate>
    <DataTemplate DataType="vm:SourcesViewModel"><v:SourcesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <!-- ambient accent glow, top-left -->
    <Border Background="{DynamicResource AmbientGlowBrush}" IsHitTestVisible="False" />

    <Grid RowDefinitions="46,*" ColumnDefinitions="232,*">

      <!-- ===================================================== title bar (draggable) -->
      <Border Grid.ColumnSpan="2" WindowDecorationProperties.ElementRole="TitleBar" Background="Transparent">
        <Grid x:Name="TitleBarGrid" ColumnDefinitions="Auto,*,Auto" Margin="18,0,150,0">
          <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
            <Panel Width="14" Height="14" VerticalAlignment="Center">
              <Border CornerRadius="7" Background="{DynamicResource AccentBrush}" BoxShadow="{DynamicResource AccentGlowShadow}" />
              <Border CornerRadius="3" Width="5" Height="3" Background="#66FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" />
            </Panel>
            <TextBlock Text="Freestash" FontSize="15" FontWeight="SemiBold" LetterSpacing="-0.3" VerticalAlignment="Center" />
            <Border Classes="pill" Padding="7,1" VerticalAlignment="Center" BorderBrush="{DynamicResource HairlineBrush}">
              <TextBlock Text="DESKTOP" FontSize="9.5" LetterSpacing="1.4" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>

          <!-- engine status pill -->
          <Button Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="ghost small"
                  Command="{Binding GoSettingsCommand}" ToolTip.Tip="Engine status · click for Settings">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource GreenBrush}" IsVisible="{Binding EngineOnline}" />
                <Ellipse Fill="{DynamicResource YellowBrush}" IsVisible="{Binding EngineStarting}" />
                <Ellipse Fill="{DynamicResource RedBrush}" IsVisible="{Binding EngineOffline}" />
              </Panel>
              <TextBlock Text="{Binding EngineText}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Center" Command="{Binding GoSearchCommand}" ToolTip.Tip="Focus search">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource IconSearch}" Size="14" Classes="faint" />
              <Border Classes="pill" Padding="6,0"><TextBlock Text="Ctrl K" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" /></Border>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- ===================================================== nav rail -->
      <DockPanel Grid.Row="1" Margin="14,6,10,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Classes="hairline" Margin="6,0" />
          <RadioButton Theme="{StaticResource NavTheme}" IsChecked="{Binding SettingsItem.IsSelected}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:Icon Data="{StaticResource IconSliders}" Size="17" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Section}" Classes="caption" Margin="12,16,0,8" IsVisible="{Binding HasSection}" />
                <RadioButton Theme="{StaticResource NavTheme}" IsChecked="{Binding IsSelected}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Data="{Binding Icon, Converter={x:Static conv:IconKeyConverter.Instance}}" Size="17" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" IsVisible="{Binding HasBadge}" Background="{DynamicResource AccentBrush}" CornerRadius="999"
                            MinWidth="20" Height="20" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </RadioButton>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <!-- ===================================================== page -->
      <Border Grid.Row="1" Grid.Column="1" Margin="0,0,14,14" CornerRadius="18" ClipToBounds="True"
              Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
              BoxShadow="{DynamicResource CardShadow}">
        <ContentControl Content="{Binding CurrentPage}" />
      </Border>
    </Grid>

    <!-- ===================================================== toast -->
    <Border IsVisible="{Binding Toasts.IsVisible}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"
            Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="999" Padding="18,10" BoxShadow="{DynamicResource PopShadow}" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Toasts.Message}" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
