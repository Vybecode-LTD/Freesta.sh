<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:v="using:Freestash.Desktop.Views"
             xmlns:c="using:Freestash.Desktop.Controls"
             x:Class="Freestash.Desktop.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <!-- Same screen as the web's pages/SearchPage.tsx: lens + aperture, source spectrum, filters, results. -->
  <Grid ColumnDefinitions="*,Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="30,24,22,0">

      <!-- the lens -->
      <Border x:Name="Lens" Classes="lens" Padding="16,16,16,18">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:ApertureRing Size="66" Total="{Binding TotalSources}" Reported="{Binding ReportedSources}"
                          Failed="{Binding FailedSources}" IsBusy="{Binding IsSearching}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center" Spacing="6">
            <TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="What are you looking for?"
                     FontSize="26" FontWeight="Medium" LetterSpacing="-0.5" Padding="0" MinHeight="0"
                     Background="Transparent" BorderThickness="0">
              <TextBox.Styles>
                <Style Selector="TextBox /template/ Border#PART_BorderElement">
                  <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
                </Style>
              </TextBox.Styles>
              <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
            </TextBox>
            <TextBlock Text="{Binding LensMeta}" Classes="mono" FontSize="11.5" LetterSpacing="0.5" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="accent" Padding="24,0" Height="48" CornerRadius="12" FontSize="15"
                  Command="{Binding SearchCommand}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <c:Icon Data="{StaticResource IconSearch}" Size="17" />
              <TextBlock Text="Search" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- query words read as categories (web: components/QueryChips.tsx) -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0" IsVisible="{Binding HasPicks}">
        <TextBlock Text="READ AS" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ItemsControl ItemsSource="{Binding Picks}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:QueryPickViewModel">
              <Button Classes="pick" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}"
                      Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).RemovePickCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                  <c:Icon Data="{StaticResource IconClose}" Size="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- the source spectrum: one column per source, bar = response time relative to the slowest -->
      <ItemsControl Grid.Row="2" ItemsSource="{Binding SourceStatuses}" Margin="0,14,0,0">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SourceStatusViewModel">
            <StackPanel Width="76" Spacing="6" ToolTip.Tip="{Binding Tooltip}">
              <Panel Height="3" HorizontalAlignment="Stretch">
                <Border CornerRadius="2" Background="{DynamicResource BorderSubtleBrush}" />
                <Border CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{DynamicResource AccentBrush}" IsVisible="{Binding Ok}" />
                <Border CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{DynamicResource RedBrush}" IsVisible="{Binding Failed}" />
                <Border CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{DynamicResource AccentLineBrush}" IsVisible="{Binding IsPending}" />
              </Panel>
              <TextBlock Text="{Binding Provider}" Classes="mono" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- filters: pills, as on the web -->
      <WrapPanel Grid.Row="3" Margin="0,18,0,0" ItemSpacing="26" LineSpacing="10">
        <!-- a star column gives the pills a finite width, so eleven media and the preset wrap at a narrow window -->
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="MEDIA" Classes="caption" VerticalAlignment="Top" Margin="0,8,12,0" />
          <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6">
          <ItemsControl ItemsSource="{Binding Media}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:OptionBase"><ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsSelected}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:OptionBase">
                <ToggleButton Classes="chip" Content="{Binding Label}" ToolTip.Tip="{Binding Hint}" IsChecked="{Binding IsSelected}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </WrapPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="PACKS" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ItemsControl x:Name="PacksItems" ItemsSource="{Binding PacksOptions}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:OptionBase">
                <RadioButton GroupName="search-packs" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Hint}" Theme="{StaticResource PillRadioTheme}" Content="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="USE" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ItemsControl x:Name="UseCaseItems" ItemsSource="{Binding UseCases}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:OptionBase">
                <RadioButton GroupName="search-use" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Hint}" Theme="{StaticResource PillRadioTheme}" Content="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="SHOW" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ItemsControl x:Name="TierItems" ItemsSource="{Binding Tiers}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:OptionBase">
                <RadioButton GroupName="search-tier" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Hint}" Theme="{StaticResource PillRadioTheme}" Content="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </WrapPanel>

      <!-- results heading, and the jump bar when there are sections (fixed above the scrolling results) -->
      <StackPanel Grid.Row="4" Margin="0,24,0,14" Spacing="14" IsVisible="{Binding HasSearched}">
        <WrapPanel ItemSpacing="12">
          <TextBlock Text="{Binding ResultsHeading}" Classes="h2" VerticalAlignment="Bottom" />
          <TextBlock Text="{Binding UseHint}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
          <TextBlock Text="{Binding ResultSummary}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding IsGrouped}" AutomationProperties.Name="Jump to a section">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ResultSectionViewModel">
              <Button Classes="jump" Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).JumpCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Total}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- results / states: one section per category, or one headless section for a single medium -->
      <Panel Grid.Row="5">
        <ScrollViewer x:Name="ResultsScroll" Padding="0,0,8,24">
          <ItemsControl x:Name="SectionsItems" ItemsSource="{Binding Sections}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="30" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ResultSectionViewModel">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowHeader}">
                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding Total}" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:AdaptiveGrid MinItemWidth="232" ItemHeight="292" Spacing="18" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:AssetCardViewModel">
                        <Button Classes="asset" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                          <v:AssetCardView />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="link" HorizontalAlignment="Left" FontSize="13" Margin="0,2,0,0" IsVisible="{Binding HasMore}" Content="{Binding ToggleText}"
                          Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).ToggleSectionCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- first run, as the web's welcome -->
        <StackPanel IsVisible="{Binding ShowEmptyHero}" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="640" Spacing="12" Margin="0,40,0,0">
          <TextBlock Text="Every result is cleared for what you'll do with it." FontSize="34" FontWeight="SemiBold" LetterSpacing="-1.3" TextWrapping="Wrap" LineHeight="38" />
          <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="15" LineHeight="22"
                     Text="The same photo can be clear for a demo site and blocked inside a template download. Pick the use, then search." />
          <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String">
                <ToggleButton Classes="chip" Content="{Binding}" IsChecked="False"
                              Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).SuggestCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding ShowNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,0,0,80">
          <TextBlock Text="Nothing cleared the filter" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Try “+ Check”, another use, or broader words." Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>

        <Border IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Top"
                Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource RedBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
      </Panel>
    </Grid>

    <!-- detail panel -->
    <Border Grid.Column="1" Width="500" IsVisible="{Binding HasDetail}" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1,0,0,0">
      <v:AssetDetailView DataContext="{Binding Detail}" />
    </Border>
  </Grid>
</UserControl>
