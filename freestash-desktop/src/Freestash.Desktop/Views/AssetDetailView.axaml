<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:fc="using:Freestash.Client"
             xmlns:c="using:Freestash.Desktop.Controls"
             x:Class="Freestash.Desktop.Views.AssetDetailView"
             x:DataType="vm:AssetDetailViewModel">
  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top" Padding="20,14,14,14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="tier" Classes.green="{Binding IsGreen}" Classes.yellow="{Binding IsYellow}" Classes.red="{Binding IsRed}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TierText}" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Scored.Uid}" Classes="mono faint" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="ghost icon" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)">
          <c:Icon Data="{StaticResource IconClose}" Size="16" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Padding="20,18,20,28">
      <StackPanel Spacing="20">
        <!-- hero -->
        <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource InsetBrush}" Height="260" BoxShadow="{DynamicResource InsetShadow}">
          <Panel>
            <c:AsyncImage Url="{Binding PreviewUrl}" Stretch="Uniform" DecodeWidth="900" IsVisible="{Binding !IsIcon}" Placeholder="{Binding Asset.MediaType}" />
            <c:AsyncImage Url="{Binding PreviewUrl}" Stretch="Uniform" DecodeWidth="0" Margin="70" IsVisible="{Binding IsIcon}" />
            <TextBlock IsVisible="{Binding IsFont}" Text="Aa Bb Gg 0123" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Border>

        <StackPanel Spacing="4">
          <SelectableTextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" LetterSpacing="-0.4" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Byline}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <!-- primary actions -->
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10"
                    Command="{Binding DownloadBestCommand}" IsEnabled="{Binding CanDownload}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{StaticResource IconDownload}" Size="16" />
                <TextBlock Text="{Binding DownloadLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,10" Command="{Binding OpenSourceCommand}" ToolTip.Tip="Open the source page in your browser">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <c:Icon Data="{StaticResource IconExternal}" Size="15" />
                <TextBlock Text="Source" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Margin="8,0,0,0" Classes="icon" Padding="11" Command="{Binding CopyCreditCommand}" ToolTip.Tip="Copy credit line">
              <c:Icon Data="{StaticResource IconCopy}" Size="15" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="PROJECT" Classes="caption" VerticalAlignment="Center" Width="92" />
            <TextBox Grid.Column="1" Text="{Binding Project}" PlaceholderText="Groups files + credits, e.g. aurora-template" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasCollections}">
            <TextBlock Text="COLLECTION" Classes="caption" VerticalAlignment="Center" Width="92" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}"
                      PlaceholderText="Add to a collection…">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="fc:Collection">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding AddToCollectionCommand}" Classes="icon" ToolTip.Tip="Add">
              <c:Icon Data="{StaticResource IconPlus}" Size="15" />
            </Button>
          </Grid>
        </StackPanel>

        <!-- facts -->
        <Border Classes="inset" Padding="14,12">
          <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="LICENSE" Classes="caption" Margin="0,3" />
            <Button Grid.Column="1" Classes="link" HorizontalAlignment="Left" Content="{Binding LicenseLabel}"
                    Command="{Binding OpenUrlCommand}" CommandParameter="{Binding LicenseUrl}" />
            <TextBlock Grid.Row="1" Text="TRUST" Classes="caption" Margin="0,6,0,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TrustText}" Margin="0,4,0,0" />
            <TextBlock Grid.Row="2" Text="SOURCE" Classes="caption" Margin="0,6,0,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceText}" Margin="0,4,0,0" />
            <!-- a pack: the web drawer's Pack / Formats / Licenses inside rows -->
            <TextBlock Grid.Row="3" Text="PACK" Classes="caption" Margin="0,6,0,3" IsVisible="{Binding IsPack}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PackFilesText}" Margin="0,4,0,0" IsVisible="{Binding IsPack}" />
            <TextBlock Grid.Row="4" Text="FORMATS" Classes="caption" Margin="0,6,0,3" IsVisible="{Binding HasFormats}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FormatsText}" Classes="mono" Margin="0,5,0,0" IsVisible="{Binding HasFormats}" />
            <TextBlock Grid.Row="5" Text="LICENSES INSIDE" Classes="caption" TextWrapping="Wrap" Margin="0,6,8,3" IsVisible="{Binding HasLicensesInside}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LicensesInside}" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding HasLicensesInside}" />
            <TextBlock Grid.Row="6" Text="SIZE" Classes="caption" Margin="0,6,0,3" IsVisible="{Binding HasSize}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SizeText}" Classes="mono" Margin="0,5,0,0" IsVisible="{Binding HasSize}" />
            <TextBlock Grid.Row="7" Text="AS STATED" Classes="caption" Margin="0,6,0,3" IsVisible="{Binding HasRawLicense}" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding RawLicense}" Classes="mono faint" TextWrapping="Wrap" Margin="0,5,0,0" IsVisible="{Binding HasRawLicense}" />
          </Grid>
        </Border>

        <!-- verdict matrix -->
        <StackPanel Spacing="8">
          <TextBlock Text="CLEARANCE BY USE" Classes="caption" />
          <ItemsControl ItemsSource="{Binding VerdictRows}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:VerdictRowViewModel">
                <Border Classes="verdict" Classes.current="{Binding IsCurrent}">
                  <Grid ColumnDefinitions="78,86,*">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                    <Border Grid.Column="1" Classes="tier" Classes.green="{Binding IsGreen}" Classes.yellow="{Binding IsYellow}" Classes.red="{Binding IsRed}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TierText}" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <ItemsControl ItemsSource="{Binding Reasons}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="x:String"><TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" LineHeight="17" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding Obligations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="x:String">
                            <Grid ColumnDefinitions="14,*" Margin="0,1,0,0">
                              <TextBlock Text="→" Classes="faint" FontSize="12" />
                              <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="16" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- attribution -->
        <StackPanel Spacing="8">
          <TextBlock Text="ATTRIBUTION" Classes="caption" />
          <Border Classes="inset" Padding="14,12">
            <SelectableTextBlock Text="{Binding Attribution}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="small" Command="{Binding CopyCreditCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{StaticResource IconCopy}" Size="13" /><TextBlock Text="Copy text" /></StackPanel>
            </Button>
            <Button Classes="small" Command="{Binding CopyHtmlCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{StaticResource IconCopy}" Size="13" /><TextBlock Text="Copy HTML" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- files -->
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="FILES" Classes="caption" />
            <TextBlock Text="· loading" Classes="caption" IsVisible="{Binding IsLoading}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Renditions}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:RenditionViewModel">
                <Border CornerRadius="10" Padding="12,6,6,6" Background="{DynamicResource RaisedBrush}">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="mono faint" VerticalAlignment="Center" Margin="10,0" />
                    <Button Grid.Column="2" Classes="ghost icon" ToolTip.Tip="Download this file"
                            Command="{Binding $parent[UserControl].((vm:AssetDetailViewModel)DataContext).DownloadRenditionCommand}" CommandParameter="{Binding}">
                      <c:Icon Data="{StaticResource IconDownload}" Size="15" />
                    </Button>
                    <Button Grid.Column="3" Classes="ghost icon" ToolTip.Tip="Open in browser"
                            Command="{Binding $parent[UserControl].((vm:AssetDetailViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                      <c:Icon Data="{StaticResource IconExternal}" Size="15" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Tips}" IsVisible="{Binding HasTips}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="x:String"><TextBlock Text="{Binding}" Classes="faint small" TextWrapping="Wrap" Margin="2,4,0,0" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasDescription}">
          <TextBlock Text="DESCRIPTION" Classes="caption" />
          <SelectableTextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="Border.verdict">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Border.verdict.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
