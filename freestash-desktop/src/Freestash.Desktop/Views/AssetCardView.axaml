<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:c="using:Freestash.Desktop.Controls"
             xmlns:conv="using:Freestash.Desktop.Converters"
             x:Class="Freestash.Desktop.Views.AssetCardView"
             x:DataType="vm:AssetCardViewModel">
  <Grid RowDefinitions="176,*">
    <Border CornerRadius="15,15,0,0" ClipToBounds="True" Background="{DynamicResource InsetBrush}">
      <Panel>
        <c:AsyncImage Url="{Binding ThumbnailUrl}" IsVisible="{Binding ShowImage}" DecodeWidth="480" Placeholder="{Binding MediaText}" />
        <c:AsyncImage Url="{Binding ThumbnailUrl}" IsVisible="{Binding IsIcon}" Stretch="Uniform" Margin="52" DecodeWidth="0" />
        <StackPanel IsVisible="{Binding IsFont}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding FontSample}" FontSize="56" FontWeight="Medium" LetterSpacing="-2" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Title}" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
        <c:Icon IsVisible="{Binding IsAudio}" Data="{StaticResource IconWave}" Size="54" StrokeThickness="1.5" Classes="faint"
                HorizontalAlignment="Center" VerticalAlignment="Center" />

        <Border Classes="tier overlay" Classes.green="{Binding IsGreen}" Classes.yellow="{Binding IsYellow}" Classes.red="{Binding IsRed}"
                Margin="10" ToolTip.Tip="{Binding TopReason}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TierText}" />
          </StackPanel>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="999" Padding="6" Background="{DynamicResource OverlayBrush}" BoxShadow="0 2 10 0 #33000000">
          <c:Icon Data="{Binding MediaIcon, Converter={x:Static conv:IconKeyConverter.Instance}}" Size="13" Classes="muted" />
        </Border>
      </Panel>
    </Border>

    <StackPanel Grid.Row="1" Margin="14,12,14,14" Spacing="5">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" MaxLines="2"
                 TextTrimming="CharacterEllipsis" LineHeight="18" />
      <TextBlock Text="{Binding SourceText}" Classes="muted small" TextTrimming="CharacterEllipsis" />
      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <Border Classes="pill" HorizontalAlignment="Left" Padding="8,2" Background="{DynamicResource InsetBrush}">
          <TextBlock Text="{Binding LicenseText}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="150"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding MetaText}" Classes="mono faint" FontSize="10.5" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
