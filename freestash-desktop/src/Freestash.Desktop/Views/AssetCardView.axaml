<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:c="using:Freestash.Desktop.Controls"
             x:Class="Freestash.Desktop.Views.AssetCardView"
             x:DataType="vm:AssetCardViewModel">
  <!-- Same card as the web's components/AssetCard.tsx: image, then a plate with title, source · year, verdict + license. -->
  <Grid RowDefinitions="180,*">
    <Border CornerRadius="15,15,0,0" ClipToBounds="True" Background="{DynamicResource InsetBrush}">
      <Panel>
        <c:AsyncImage Url="{Binding ThumbnailUrl}" IsVisible="{Binding ShowImage}" DecodeWidth="480" Placeholder="{Binding MediaText}" />
        <c:AsyncImage Url="{Binding ThumbnailUrl}" IsVisible="{Binding IsIcon}" Stretch="Uniform" Margin="52" DecodeWidth="0" />
        <StackPanel IsVisible="{Binding IsFont}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
          <TextBlock Text="{Binding FontSample}" FontSize="56" FontWeight="Medium" LetterSpacing="-2" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Title}" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
        <c:Icon IsVisible="{Binding IsAudio}" Data="{StaticResource IconWave}" Size="54" StrokeThickness="1.5" Classes="muted"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        <!-- a pack's badge on its own opaque plate (web: .pack-badge), so the preview never sets its contrast -->
        <Border IsVisible="{Binding IsPack}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
          <TextBlock Text="{Binding PackBadge}" Classes="mono" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.6"
                     Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
      </Panel>
    </Border>

    <StackPanel Grid.Row="1" Margin="14,12,14,14" Spacing="4">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding CardMeta}" Classes="mono" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" ToolTip.Tip="{Binding TopReason}">
          <Panel Width="7" Height="7" VerticalAlignment="Center">
            <Ellipse Classes="dot" Fill="{DynamicResource GreenBrush}" IsVisible="{Binding IsGreen}" Effect="drop-shadow(0 0 6 #904BE08A)" />
            <Ellipse Classes="dot" Fill="{DynamicResource YellowBrush}" IsVisible="{Binding IsYellow}" Effect="drop-shadow(0 0 6 #90F3D35B)" />
            <Ellipse Classes="dot" Fill="{DynamicResource RedBrush}" IsVisible="{Binding IsRed}" Effect="drop-shadow(0 0 6 #90FF6B6B)" />
          </Panel>
          <Panel>
            <TextBlock Classes="verdict" Text="{Binding TierText}" Foreground="{DynamicResource GreenBrush}" IsVisible="{Binding IsGreen}" />
            <TextBlock Classes="verdict" Text="{Binding TierText}" Foreground="{DynamicResource YellowBrush}" IsVisible="{Binding IsYellow}" />
            <TextBlock Classes="verdict" Text="{Binding TierText}" Foreground="{DynamicResource RedBrush}" IsVisible="{Binding IsRed}" />
          </Panel>
        </StackPanel>
        <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="6" Padding="7,2" Margin="10,0,0,0"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
          <TextBlock Text="{Binding LicenseText}" Classes="mono" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="130"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
