<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:c="using:Freestash.Desktop.Controls"
             x:Class="Freestash.Desktop.Views.SourcesView"
             x:DataType="vm:SourcesViewModel">
  <Grid RowDefinitions="Auto,*" Margin="30,26,30,0">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Sources" Classes="h1" />
        <TextBlock Text="{Binding Summary}" Classes="muted" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="7"><c:Icon Data="{StaticResource IconKey}" Size="15" /><TextBlock Text="Manage API keys" /></StackPanel>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" Padding="0,0,6,24">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="14" LineSpacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SourceRowViewModel">
            <Border Classes="card" Width="340" Padding="16,14" MinHeight="150">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Media}" Classes="mono faint" FontSize="11" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="tier" Classes.green="{Binding Enabled}" Classes.yellow="{Binding !Enabled}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                  <Button Classes="link small" Content="Website" Command="{Binding $parent[UserControl].((vm:SourcesViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Homepage}" />
                  <Button Classes="link small" Content="Get a key" IsVisible="{Binding NeedsKey}"
                          Command="{Binding $parent[UserControl].((vm:SourcesViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding SignupUrl}" />
                  <TextBlock Text="{Binding VerifiedText}" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Notes}" Classes="muted small" TextWrapping="Wrap" Margin="0,10,0,0" MaxLines="4" TextTrimming="CharacterEllipsis" LineHeight="17" />
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
