<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Freestash.Desktop.ViewModels"
             xmlns:c="using:Freestash.Desktop.Controls"
             x:Class="Freestash.Desktop.Views.SignInView"
             x:DataType="vm:SignInViewModel"
             Background="{DynamicResource CanvasBrush}">
  <!-- Same screen as the web's pages/SignInPage.tsx: brand side with the aperture, form card on the right. -->
  <Grid ColumnDefinitions="11*,10*">
    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
      <StackPanel VerticalAlignment="Center" Margin="72,0,48,40" Spacing="28" MaxWidth="560" HorizontalAlignment="Left">
        <c:ApertureRing x:Name="Ring" Size="148" Total="20" Reported="20" HorizontalAlignment="Left" />
        <TextBlock Text="Public-domain and openly licensed media, cleared for what you'll actually do with it."
                   FontSize="36" FontWeight="SemiBold" LetterSpacing="-1.4" LineHeight="41" TextWrapping="Wrap" />
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{StaticResource IconGlobe}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="20 museums, archives and libraries searched at once" Classes="muted" VerticalAlignment="Center" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{StaticResource IconShield}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Every result cleared per use: demo, client, bundled, merch" Classes="muted" VerticalAlignment="Center" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12"><c:Icon Data="{StaticResource IconRetry}" Size="17" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="One account on the web and the desktop app" Classes="muted" VerticalAlignment="Center" /></StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420" Spacing="14" Margin="16,0,16,40">
      <Border Classes="card" Padding="28">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.5" />
          <StackPanel Spacing="8" IsVisible="{Binding IsSignUp}">
            <TextBlock Text="NAME (OPTIONAL)" Classes="caption" />
            <TextBox Text="{Binding DisplayName}" />
          </StackPanel>
          <StackPanel Spacing="8">
            <TextBlock Text="EMAIL" Classes="caption" />
            <TextBox x:Name="EmailBox" Text="{Binding Email}">
              <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" /></TextBox.KeyBindings>
            </TextBox>
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding ShowPassword}">
            <TextBlock Text="PASSWORD" Classes="caption" />
            <TextBox Text="{Binding Password}" PasswordChar="•">
              <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" /></TextBox.KeyBindings>
            </TextBox>
          </StackPanel>
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" FontSize="13" />
          <Border IsVisible="{Binding HasNote}" Classes="raised" Padding="12,10">
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13" />
          </Border>
          <Button Classes="accent" Height="48" CornerRadius="12" FontSize="15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}" Content="{Binding Cta}" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="link small" Content="Forgot your password?" Command="{Binding ShowForgotCommand}" IsVisible="{Binding IsSignIn}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsSignIn}">
              <TextBlock Text="New here?" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              <Button Classes="link small" Content="Create an account" Command="{Binding ShowSignUpCommand}" />
            </StackPanel>
            <Button Classes="link small" Content="← Back to sign in" Command="{Binding ShowSignInCommand}" IsVisible="{Binding !IsSignIn}" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Text="The website at freesta.sh uses this same account." Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
      <Button Classes="link small" HorizontalAlignment="Center" Command="{Binding UseLocalEngineCommand}"
              Content="Running the Python engine yourself? Use a local engine instead" />
    </StackPanel>
  </Grid>
</UserControl>
